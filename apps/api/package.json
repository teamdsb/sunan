{
  "name": "api",
  "private": true,
  "version": "0.0.6",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@expo-google-fonts/noto-sans-sc": "^0.4.3",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "ali-oss": "^6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "4.22.1",
    "ioredis": "^5.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "subset-font": "2.5.0",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "jest --config ./jest.unit.config.ts",
    "test:integration": "jest --config ./jest.integration.config.ts",
    "migration:run": "NODE_PATH=. ts-node src/database/run-migrations.ts",
    "migration:safety": "NODE_PATH=. ts-node src/database/run-safety-legacy-migration.ts",
    "migration:generate": "NODE_PATH=. typeorm-ts-node-commonjs migration:generate src/database/migrations/auto -d src/database/data-source.ts",
    "seed": "NODE_PATH=. ts-node src/database/seeds/run-seed.ts"
  }
}
