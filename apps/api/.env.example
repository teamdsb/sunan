NODE_ENV=development
PORT=3000
SUNAN_VERSION=0.0.4

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sunan
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

REDIS_URL=redis://127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_SECRET=01234567890123456789012345678901
JWT_EXPIRES_IN=7200s

WECOM_CORP_ID=ww-test-corp
WECOM_AGENT_ID=1000001
WECOM_AGENT_SECRET=test-agent-secret
WECOM_REDIRECT_URI=https://example.com/auth
WEB_PUBLIC_URL=https://example.com
API_PUBLIC_URL=https://api.example.com
WECOM_SYSTEM_ADMIN_USER_IDS=
WECOM_CALLBACK_TOKEN=test-callback-token
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_ALLOWED_IP_RANGES=

OSS_DRIVER=aliyun
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=sunan-files
OSS_ACCESS_KEY_ID=test-access-key-id
OSS_ACCESS_KEY_SECRET=test-access-key-secret
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_FORCE_PATH_STYLE=true
