SUNAN_SOURCE_DIR=/dev/sunan/sunan-source/current
SUNAN_VERSION=0.0.6

DB_NAME=sunan
DB_USER=sunan
DB_PASSWORD=replace-with-strong-password

REDIS_USER=sunan
REDIS_PASSWORD=replace-with-strong-password

OSS_REGION=us-east-1
OSS_BUCKET=sunan-files
OSS_ACCESS_KEY_ID=sunan
OSS_ACCESS_KEY_SECRET=replace-with-strong-password
OSS_PRESIGN_EXPIRE=300
OSS_DOWNLOAD_EXPIRE=900

JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=7200s

APP_DOMAIN=qzssncb.com
WEB_PUBLIC_URL=https://app.qzssncb.com
API_PUBLIC_URL=https://api.qzssncb.com

WECOM_CORP_ID=ww-replace-me
WECOM_AGENT_ID=1000001
WECOM_AGENT_SECRET=replace-me
WECOM_REDIRECT_URI=https://app.qzssncb.com/auth/callback
WECOM_SYSTEM_ADMIN_USER_IDS=
WECOM_CALLBACK_TOKEN=replace-with-strong-token
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_ALLOWED_IP_RANGES=
WECOM_CALLBACK_ALLOWED_IP_RANGES_FILE=/run/sunan/wecom-ips/callback-ip-list.txt
WECOM_CALLBACK_SIGNATURE_REQUIRED=true
WECOM_CALLBACK_MAX_SKEW_SECONDS=300
